# ResQIntel Backend — Example Configuration
# Copy this to .env and fill in real values. Never commit .env to version control.

# Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Data Storage
# For local development: STORAGE_BACKEND=json
# For production with Atlas: STORAGE_BACKEND=mongodb
STORAGE_BACKEND=json
JSON_DATA_DIR=./data
MONGODB_URI=
MONGODB_DB_NAME=resqintel

# Authentication — REQUIRED
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Bootstrap Super Admin (only used if no admin exists in DB on first run)
# Change immediately after first login in production.
BOOTSTRAP_ADMIN_EMAIL=admin@resqintel.org
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Operations Lead

# Google Gemini AI (optional — extraction degrades gracefully without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
